{
  "name": "nous",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "pnpm --filter @nous/desktop dev",
    "build": "pnpm --filter @nous/native build:debug && pnpm --filter @nous/desktop build",
    "build:native": "pnpm --filter @nous/native build:debug",
    "check": "pnpm --filter @nous/desktop check",
    "lint": "pnpm --filter @nous/desktop lint",
    "test": "pnpm --filter @nous/desktop test",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
