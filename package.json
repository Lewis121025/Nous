{
  "name": "nous",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "pnpm build:native && pnpm --filter @nous/desktop dev",
    "build": "pnpm --filter @nous/native build:debug && pnpm --filter @nous/desktop build",
    "build:native": "pnpm --filter @nous/native build",
    "check": "pnpm --filter @nous/desktop check",
    "lint": "pnpm --filter @nous/desktop lint",
    "test": "pnpm --filter @nous/desktop test",
    "test:core": "pnpm build && pnpm --filter @nous/desktop test:core",
    "test:preview": "pnpm build && pnpm --filter @nous/desktop test:preview",
    "test:performance": "pnpm build && pnpm --filter @nous/desktop test:performance",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "playwright-core": "^1.63.0",
    "prettier": "^3.6.2",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
